EXP 4.6
#include <iostream>
using namespace std;

int main() {
    int n;
    cin >> n;

    int a[100][100];

    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            cin >> a[i][j];

    for (int i = 0; i < n; i++) {
        if (i % 2 == 0) {
            for (int j = 0; j < n; j++)
                cout << a[i][j] << " ";
        } else {
            for (int j = n - 1; j >= 0; j--)
                cout << a[i][j] << " ";
        }
    }
}

