#include <iostream>
using namespace std;

int main() {
    int n;
    cin >> n;

    int a[100];

    for (int i = 0; i < n; i++)
        cin >> a[i];

    int first = -1, second = -1;

    for (int i = 0; i < n; i++) {
        if (a[i] > first) {
            second = first;
            first = a[i];
        } else if (a[i] > second && a[i] != first) {
            second = a[i];
        }
    }

    cout << second;
}


EXP 4.2
#include <iostream>
using namespace std;

int main() {
    int n;
    cin >> n;

    int a[100];

    for (int i = 0; i < n; i++)
        cin >> a[i];

    int flag = 1;

    for (int i = 1; i < n; i++) {
        if (a[i] < a[i - 1]) {
            flag = 0;
            break;
        }
    }

    if (flag == 1)
        cout << "Sorted";
    else
        cout << "Not Sorted";
}


EXP 4.3
#include <iostream>
using namespace std;

int main() {
    int n;
    cin >> n;

    int a[100];

    for (int i = 0; i < n; i++)
        cin >> a[i];

    int j = 0;

    for (int i = 0; i < n; i++) {
        if (a[i] != 0) {
            int temp = a[i];
            a[i] = a[j];
            a[j] = temp;
            j++;
        }
    }

    for (int i = 0; i < n; i++)
        cout << a[i] << " ";
}


