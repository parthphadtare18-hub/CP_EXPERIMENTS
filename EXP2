EXP 2.4
#include <iostream>
using namespace std;

int main() {
    int n;
    cin >> n;

    long long fact = 1;

    for (int i = 1; i <= n; i++)
        fact = fact * i;

    int count = 0;

    while (fact > 0) {
        count++;
        fact = fact / 10;
    }

    cout << count;
}


