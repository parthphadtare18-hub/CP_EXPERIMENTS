#include <iostream>
using namespace std;

int main() {
    int n, pos;
    cin >> n >> pos;

    int res = (n >> pos) & 1;

    if (res == 1)
        cout << "Set";
    else
        cout << "Not Set";
}


EXP 2.2
#include <iostream>
using namespace std;

int main() {
    int n;
    cin >> n;

    int a[100];

    for (int i = 0; i < n; i++)
        cin >> a[i];

    int max_val = 0;

    for (int i = 0; i < n; i++) {
        for (int j = i + 1; j < n; j++) {
            int val = a[i] & a[j];
            if (val > max_val)
                max_val = val;
        }
    }

    cout << max_val;
}


