#include <iostream>
#include <stack>
using namespace std;

struct Node {
    int data;
    Node* next;
};

int main() {
    Node* head = NULL;

    // create list 1->2->3
    Node* n1 = new Node{1, NULL};
    Node* n2 = new Node{2, NULL};
    Node* n3 = new Node{3, NULL};

    head = n1;
    n1->next = n2;
    n2->next = n3;

    stack<int> s;

    Node* temp = head;

    while (temp != NULL) {
        s.push(temp->data);
        temp = temp->next;
    }

    temp = head;

    while (temp != NULL) {
        temp->data = s.top();
        s.pop();
        temp = temp->next;
    }

    temp = head;

    while (temp != NULL) {
        cout << temp->data << " ";
        temp = temp->next;
    }
}


