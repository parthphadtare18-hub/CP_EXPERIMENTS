#include <iostream>
using namespace std;

int stack[100];
int top = -1;

void push(int x) {
    if (top == 99) {
        cout << "Overflow\n";
        return;
    }
    top++;
    stack[top] = x;
}

void pop() {
    if (top == -1) {
        cout << "Underflow\n";
        return;
    }
    cout << "Popped: " << stack[top] << endl;
    top--;
}

void display() {
    for (int i = top; i >= 0; i--)
        cout << stack[i] << " ";
    cout << endl;
}

int main() {
    push(10);
    push(20);
    push(30);

    display();

    pop();
    display();
}


