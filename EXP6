#include <iostream>
using namespace std;

int binary(int a[], int l, int r, int x) {
    if (l > r)
        return -1;

    int mid = (l + r) / 2;

    if (a[mid] == x)
        return mid;

    if (x < a[mid])
        return binary(a, l, mid - 1, x);

    return binary(a, mid + 1, r, x);
}

int main() {
    int n, x;
    cin >> n;

    int a[100];

    for (int i = 0; i < n; i++)
        cin >> a[i];

    cin >> x;

    cout << binary(a, 0, n - 1, x);
}


