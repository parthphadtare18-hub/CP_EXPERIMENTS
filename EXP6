int main() {
    int n;
    cin >> n;

    int a[100];

    for (int i = 0; i < n; i++)
        cin >> a[i];

    for (int i = 0; i < n; i++) {
        if ((i == 0 || a[i] >= a[i - 1]) &&
            (i == n - 1 || a[i] >= a[i + 1])) {
            cout << a[i];
            break;
        }
    }
}


EXP 6.4
#include <iostream>
using namespace std;

int main() {
    int n, x;
    cin >> n;

    int a[100];

    for (int i = 0; i < n; i++)
        cin >> a[i];

    cin >> x;

    int l = 0, r = n - 1;

    while (l < r) {
        int sum = a[l] + a[r];

        if (sum == x) {
            cout << "Found";
            return 0;
        } else if (sum < x) {
            l++;
        } else {
            r--;
        }
    }

    cout << "Not Found";
}


