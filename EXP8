#include <iostream>
using namespace std;

int main() {
    string s;
    cin >> s;

    int count[256] = {0};

    for (int i = 0; i < s.length(); i++)
        count[s[i]]++;

    for (int i = 0; i < s.length(); i++) {
        if (count[s[i]] > 1) {
            cout << s[i];
            return 0;
        }
    }

    cout << -1;
}


