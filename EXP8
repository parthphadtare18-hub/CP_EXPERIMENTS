#include <iostream>
using namespace std;

int main() {
    string s;
    getline(cin, s);

    int n = s.length();

    for (int i = n - 1; i >= 0; i--) {
        int j = i;

        while (i >= 0 && s[i] != ' ')
            i--;

        for (int k = i + 1; k <= j; k++)
            cout << s[k];

        cout << " ";
    }
}

