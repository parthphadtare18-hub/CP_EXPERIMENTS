EXP 7.5
#include <iostream>
#include <algorithm>
using namespace std;

int main() {
    int n;
    cin >> n;

    int a[100];

    for (int i = 0; i < n; i++)
        cin >> a[i];

    sort(a, a + n);

    for (int i = 0; i < n - 2; i++) {
        int l = i + 1;
        int r = n - 1;

        while (l < r) {
            int sum = a[i] + a[l] + a[r];

            if (sum == 0) {
                cout << a[i] << " " << a[l] << " " << a[r] << endl;
                l++;
                r--;
            } else if (sum < 0)
                l++;
            else
                r--;
        }
    }
}


