EXP 7.2
#include <iostream>
using namespace std;

int main() {
    int n;
    cin >> n;

    int a[100];

    for (int i = 0; i < n; i++)
        cin >> a[i];

    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (a[j] > a[j + 1]) {
                int t = a[j];
                a[j] = a[j + 1];
                a[j + 1] = t;
            }
        }
    }

    for (int i = 0; i < n; i++)
        cout << a[i] << " ";
}


EXP 7.3
#include <iostream>
using namespace std;

int main() {
    int n, m;
    cin >> n >> m;

    int a[100], b[100];

    for (int i = 0; i < n; i++) cin >> a[i];
    for (int i = 0; i < m; i++) cin >> b[i];

    // Union
    for (int i = 0; i < n; i++)
        cout << a[i] << " ";

    for (int i = 0; i < m; i++) {
        int found = 0;
        for (int j = 0; j < n; j++) {
            if (b[i] == a[j])
                found = 1;
        }
        if (found == 0)
            cout << b[i] << " ";
    }

    cout << endl;

    // Intersection
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < m; j++) {
            if (a[i] == b[j])
                cout << a[i] << " ";
        }
    }
}


