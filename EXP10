EXP 10.1
#include <iostream>
using namespace std;

int q[100];
int front = -1, rear = -1;

void enqueue(int x) {
    if (rear == 99) {
        cout << "Overflow\n";
        return;
    }

    if (front == -1)
        front = 0;

    rear++;
    q[rear] = x;
}

void dequeue() {
    if (front == -1 || front > rear) {
        cout << "Underflow\n";
        return;
    }

    cout << "Removed: " << q[front] << endl;
    front++;
}

void display() {
    for (int i = front; i <= rear; i++)
        cout << q[i] << " ";
    cout << endl;
}

int main() {
    enqueue(10);
    enqueue(20);
    enqueue(30);

    display();

    dequeue();
    display();
}


EXP 10.2
#include <iostream>
#include <queue>
using namespace std;

int main() {
    queue<int> q;

    q.push(10);
    q.push(20);
    q.push(30);

    while (!q.empty()) {
        cout << q.front() << " ";
        q.pop();
    }
}


EXP 10.3
#include <iostream>
#include <deque>
using namespace std;

int main() {
    deque<int> dq;

    dq.push_back(10);
    dq.push_back(20);
    dq.push_front(5);

    for (int i = 0; i < dq.size(); i++)
        cout << dq[i] << " ";

    cout << endl;

    dq.pop_front();
    dq.pop_back();

    for (int i = 0; i < dq.size(); i++)
        cout << dq[i] << " ";
}
